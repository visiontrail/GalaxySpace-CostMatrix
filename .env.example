# Local Docker defaults. Copy to .env and adjust only when needed.
COMPOSE_PROJECT_NAME=costmatrix
DOCKERHUB_NAMESPACE=galaxyspaceai
IMAGE_TAG=local

BACKEND_PORT=8000
FRONTEND_PORT=8180

APP_NAME=CostMatrix
APP_VERSION=1.0.0
DEBUG=false
ALLOWED_ORIGINS=["http://localhost:8180","http://127.0.0.1:8180"]
SECRET_KEY=local-development-only-change-before-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
DEFAULT_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD_FILE=/app/config/initial_admin_password.txt
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE=200

# Self-contained local storage. Production keeps its existing MySQL settings.
DATABASE_URL=
DB_TYPE=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=costmatrix
DB_USER=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Claude Agent SDK bootstrap defaults. The Admin settings page can override them.
ANTHROPIC_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MAX_TURNS=12
ANTHROPIC_REQUEST_TIMEOUT_SECONDS=180
AGENT_TOTAL_TIMEOUT_SECONDS=1800
AGENT_MAX_RESULT_ROWS=500
